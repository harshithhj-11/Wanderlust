<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="/listings/show.css">

<link
    href="https://unpkg.com/maplibre-gl@latest/dist/maplibre-gl.css"
    rel="stylesheet"
/>


<div class="listing-card">

    <img
        src="<%= listing.image.url %>"
        alt="<%= listing.title %>"
        class="listing-image"
    >


    <div class="listing-content">

        <p class="location">
            <%= listing.location %>, <%= listing.country %>
        </p>

        <h1><%= listing.title %></h1>

        <p class="description">
            <%= listing.description %>
        </p>

        <p class="owner">
            <strong>Owner:</strong>
            <i><%= listing.owner.username %></i>
        </p>


        <div class="bottom-section">

            <p class="price">
                ₹<%= listing.price.toLocaleString("en-IN") %>
                <span>/ night</span>
            </p>


            <% if (currentUser && listing.owner.equals(currentUser._id)) { %>

                <div class="listing-actions">

                    <a
                        href="/listings/<%= listing._id %>/edit"
                        class="edit-btn"
                    >
                        Edit
                    </a>


                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>?_method=DELETE"
                    >

                        <button
                            type="submit"
                            class="delete-btn"
                        >
                            Delete
                        </button>

                    </form>

                </div>

            <% } %>

        </div>


        <!-- =========================
             MAP
        ========================== -->

        <div id="map"></div>


        <!-- =========================
             REVIEW SECTION
        ========================== -->

        <div class="review-divider"></div>


        <div class="review-section">

            <% if (currentUser) { %>

                <h4>Leave a Review</h4>


                <form
                    class="review-form needs-validation"
                    action="/listings/<%= listing._id %>/reviews"
                    method="POST"
                    novalidate
                >

                    <div class="review-field">

                        <label>Rating</label>

                        <div class="star-rating">

                            <input
                                type="radio"
                                id="star5"
                                name="review[rating]"
                                value="5"
                            >
                            <label for="star5">★</label>


                            <input
                                type="radio"
                                id="star4"
                                name="review[rating]"
                                value="4"
                            >
                            <label for="star4">★</label>


                            <input
                                type="radio"
                                id="star3"
                                name="review[rating]"
                                value="3"
                            >
                            <label for="star3">★</label>


                            <input
                                type="radio"
                                id="star2"
                                name="review[rating]"
                                value="2"
                            >
                            <label for="star2">★</label>


                            <input
                                type="radio"
                                id="star1"
                                name="review[rating]"
                                value="1"
                                required
                            >
                            <label for="star1">★</label>

                        </div>

                    </div>


                    <div class="review-field">

                        <label for="comment">
                            Comment
                        </label>


                        <textarea
                            id="comment"
                            name="review[comment]"
                            rows="4"
                            placeholder="Share your experience..."
                            required
                        ></textarea>


                        <div class="invalid-feedback">
                            Please enter a comment.
                        </div>

                    </div>


                    <button
                        type="submit"
                        class="review-btn"
                    >
                        Submit Review
                    </button>

                </form>


            <% } else { %>

                <p>
                    <a href="/users/login" id="login-link">
                        Log in
                    </a>
                    to leave a review.
                </p>

            <% } %>


            <!-- =========================
                 ALL REVIEWS
            ========================== -->

            <div class="all-reviews">

                <br>

                <h2>All Reviews</h2>


                <div class="reviews-container">

                    <% listing.reviews.forEach(review => { %>

                        <div class="review-card">


                            <div class="review-rating">

                                <% for(let i = 1; i <= 5; i++) { %>

                                    <% if(i <= review.rating) { %>

                                        <span>★</span>

                                    <% } else { %>

                                        <span class="empty-star">☆</span>

                                    <% } %>

                                <% } %>

                            </div>


                            <p class="review-author">

                                <strong>
                                    <%= review.author.username %>
                                </strong>

                            </p>


                            <p class="review-comment">
                                <%= review.comment %>
                            </p>


                            <small class="review-date">

                                <%= review.createdAt.toLocaleDateString("en-IN") %>

                            </small>


                            <% if (
                                currentUser &&
                                review.author &&
                                review.author._id.equals(currentUser._id)
                            ) { %>


                                <form
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    method="POST"
                                    class="review-delete-form"
                                >

                                    <button
                                        type="submit"
                                        class="review-delete-btn"
                                    >
                                        Delete
                                    </button>

                                </form>


                            <% } %>


                        </div>

                    <% }) %>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================
     MAPLIBRE
========================== -->

<script src="https://unpkg.com/maplibre-gl@5.7.0/dist/maplibre-gl.js"></script>

<script>

    const map = new maplibregl.Map({
        container: "map",
        style: "https://demotiles.maplibre.org/style.json",
        center: <%- JSON.stringify(listing.geometry.coordinates) %>,
        zoom: 10
    });

    new maplibregl.Marker()
    .setLngLat(<%- JSON.stringify(listing.geometry.coordinates) %>)
    .setPopup(
        new maplibregl.Popup({ offset: 25 })
            .setHTML("<h4><%= listing.title %></h4><p>Exact location provided after booking.</p>")
    )
    .addTo(map);

</script>