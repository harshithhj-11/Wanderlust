<% layout("/layouts/boilerplate") %>
<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h2 class="text-center mb-4">
                        Create an Account
                    </h2>

                    <form
                        action="/users/signup"
                        method="POST"
                        class="needs-validation"
                        novalidate
                    >

                        <!-- Username -->

                        <div class="mb-3">

                            <label
                                for="username"
                                class="form-label"
                            >
                                Username
                            </label>

                            <input
                                type="text"
                                id="username"
                                name="username"
                                class="form-control"
                                placeholder="Enter your username"
                                required
                            >

                            <div class="invalid-feedback">
                                Please enter a username.
                            </div>

                        </div>


                        <!-- Password -->

                        <div class="mb-4">

                            <label
                                for="password"
                                class="form-label"
                            >
                                Password
                            </label>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                class="form-control"
                                placeholder="Enter your password"
                                required
                                minlength="6"
                            >

                            <div class="invalid-feedback">
                                Please enter a password of at least 6 characters.
                            </div>

                        </div>


                        <!-- Submit -->

                        <button
                            type="submit"
                            class="btn btn-dark w-100"
                        >
                            Sign Up
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>